<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clkRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_widget_4x2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <AnalogClock
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:dial="@drawable/widget_clock_dial"
            android:hand_hour="@drawable/widget_clock_hand_hour"
            android:hand_minute="@drawable/widget_clock_hand_minute" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.35"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/tvClkWeekday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thứ Bảy"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvClkDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="24 tháng 10, 2026"
                android:textColor="#C9D6FF"
                android:textSize="14sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvClkAlarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_widget_chip"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="⏰ Chưa có báo thức"
                android:textColor="#E8EEFF"
                android:textSize="12sp"
                android:maxLines="2" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
