<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#102040"
    android:orientation="vertical"
    android:padding="8dp">
    <LinearLayout
        android:id="@+id/row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvRow0" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#FFFFFF" android:textSize="13sp" />
        <TextView android:id="@+id/btnRow0" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="6dp" android:text="On/Off" android:textColor="#90CAF9" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvRow1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#FFFFFF" android:textSize="13sp" />
        <TextView android:id="@+id/btnRow1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="6dp" android:text="On/Off" android:textColor="#90CAF9" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvRow2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#FFFFFF" android:textSize="13sp" />
        <TextView android:id="@+id/btnRow2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="6dp" android:text="On/Off" android:textColor="#90CAF9" android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:id="@+id/btnWidgetAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="6dp"
        android:text="+ Thêm báo thức"
        android:textColor="#BBDEFB"
        android:textStyle="bold" />
</LinearLayout>
