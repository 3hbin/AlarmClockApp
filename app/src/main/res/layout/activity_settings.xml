    android:text="@string/nav_style_title" android:textStyle="bold" android:textSize="15sp" android:layout_marginTop="0dp" android:layout_marginBottom="4dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="@string/nav_style_hint" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" android:layout_marginBottom="4dp"/>
<RadioGroup android:id="@+id/rgNavStyle" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginBottom="0dp">
<RadioButton android:id="@+id/rbNavGoogle" android:layout_width="match_parent"
