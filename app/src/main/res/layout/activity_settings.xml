<RadioButton android:id="@+id/rbNavPersistent" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/nav_style_persistent"/>
<RadioButton android:id="@+id/rbNavCurved" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/nav_style_curved"/>
</RadioGroup>
<View android:layout_width="match_parent" android:layout_height="1dp"
    android:background="?android:attr/textColorSecondary" android:alpha="0.12"
    android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="@string/font_size" android:textStyle="bold" android:textSize="15sp" android:layout_marginTop="0dp" android:layout_marginBottom="4dp"/>
<RadioGroup android:id="@+id/rgFontScale" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:layout_marginBottom="0dp">
<RadioButton android:id="@+id/rbFontSmall" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/font_small"/>
<RadioButton android:id="@+id/rbFontNormal" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/font_medium"/>
<RadioButton android:id="@+id/rbFontLarge" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/font_large"/>
</RadioGroup>
<View android:layout_width="match_parent" android:layout_height="1dp"
    android:background="?android:attr/textColorSecondary" android:alpha="0.12"
    android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="@string/dark_mode" android:textStyle="bold" android:textSize="15sp" android:layout_marginTop="0dp" android:layout_marginBottom="4dp"/>
<RadioGroup android:id="@+id/rgDarkMode" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginBottom="0dp">
<RadioButton android:id="@+id/rbDarkSystem" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/dark_system"/>
<RadioButton android:id="@+id/rbDarkOn" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/dark_on"/>
<RadioButton android:id="@+id/rbDarkOff" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/dark_off"/>
</RadioGroup>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
<View android:layout_width="match_parent" android:layout_height="10dp"/>
