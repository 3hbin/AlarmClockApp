<SeekBar android:id="@+id/seekVolume" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:max="100"/>
<View android:layout_width="match_parent" android:layout_height="1dp"
    android:background="?android:attr/textColorSecondary" android:alpha="0.12"
    android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:text="@string/vibrate_mode" android:textSize="16sp"/>
    <com.example.alarmclock.LoadSwitchView android:id="@+id/switchVibrate"
        android:layout_width="52dp" android:layout_height="32dp"/>
</LinearLayout>
<View android:layout_width="match_parent" android:layout_height="1dp"
    android:background="?android:attr/textColorSecondary" android:alpha="0.12"
    android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="@string/snooze_default" android:textStyle="bold" android:textSize="15sp" android:layout_marginTop="0dp" android:layout_marginBottom="4dp"/>
<RadioGroup android:id="@+id/rgSnoozeDefault" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:layout_marginBottom="0dp">
<RadioButton android:id="@+id/rbSnooze5" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/min_5"/>
<RadioButton android:id="@+id/rbSnooze10" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/min_10"/>
<RadioButton android:id="@+id/rbSnooze15" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/min_15"/>
</RadioGroup>
<View android:layout_width="match_parent" android:layout_height="1dp"
    android:background="?android:attr/textColorSecondary" android:alpha="0.12"
    android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
<TextView android:id="@+id/tvRingDurationTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Thời lượng đổ chuông" android:textStyle="bold" android:textSize="15sp" android:layout_marginTop="0dp" android:layout_marginBottom="4dp"/>
<TextView android:id="@+id/tvRingDurationHint" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Hết giờ tự tắt, không kêu suốt ngày" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" android:layout_marginBottom="4dp"/>
<RadioGroup android:id="@+id/rgRingDuration" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:layout_marginBottom="0dp">
<RadioButton android:id="@+id/rbRing1" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1" android:text="1p"/>
<RadioButton android:id="@+id/rbRing5" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1" android:text="5p"/>
<RadioButton android:id="@+id/rbRing10" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1" android:text="10p"/>
<RadioButton android:id="@+id/rbRing15" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1" android:text="15p"/>
<RadioButton android:id="@+id/rbRing30" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1" android:text="30p"/>
</RadioGroup>
<View android:layout_width="match_parent" android:layout_height="1dp"
    android:background="?android:attr/textColorSecondary" android:alpha="0.12"
    android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical">
