        android:text="Đang ở nhà — tạm dừng báo thức" android:textSize="16sp"/>
    <com.example.alarmclock.LoadSwitchView android:id="@+id/switchPauseHome"
        android:layout_width="52dp" android:layout_height="32dp"/>
</LinearLayout>
<View android:layout_width="match_parent" android:layout_height="1dp"
    android:background="?android:attr/textColorSecondary" android:alpha="0.12"
    android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
