    android:text="Tắt sẽ khóa icon buổi tối và thoát app." android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" android:layout_marginBottom="0dp"/>
<View android:layout_width="match_parent" android:layout_height="1dp"
    android:background="?android:attr/textColorSecondary" android:alpha="0.12"
    android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
