<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Ngôn ngữ (~195) -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ngôn ngữ / Language" android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Chọn trong gần 200 ngôn ngữ. Giao diện đầy đủ hiện có Tiếng Việt &amp; English; ngôn ngữ khác áp dụng định dạng ngày/giờ và fallback hệ thống."
            android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="6dp"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvLanguageTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ngôn ngữ ứng dụng"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/tvLanguageValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Theo hệ thống"
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="?android:attr/textColorSecondary"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Âm lượng báo thức" android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/tvVolumeValue" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="80%"/>
        <SeekBar android:id="@+id/seekVolume" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="100" android:layout_marginBottom="16dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Chế độ rung" android:textSize="16sp"/>
            <com.example.alarmclock.LoadSwitchView
                android:id="@+id/switchVibrate"
                android:layout_width="52dp" android:layout_height="32dp"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Thời gian hoãn (Snooze) mặc định" android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
        <RadioGroup android:id="@+id/rgSnoozeDefault" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <RadioButton android:id="@+id/rbSnooze5" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="5 phút"/>
            <RadioButton android:id="@+id/rbSnooze10" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="10 phút"/>
            <RadioButton android:id="@+id/rbSnooze15" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="15 phút"/>
        </RadioGroup>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Chế độ tối" android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <RadioGroup android:id="@+id/rgDarkMode" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginBottom="12dp">
            <RadioButton android:id="@+id/rbDarkSystem" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Theo hệ thống"/>
            <RadioButton android:id="@+id/rbDarkOn" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Bật"/>
            <RadioButton android:id="@+id/rbDarkOff" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Tắt"/>
        </RadioGroup>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Định dạng 24 giờ" android:textSize="16sp"/>
            <com.example.alarmclock.LoadSwitchView
                android:id="@+id/switch24h"
                android:layout_width="52dp" android:layout_height="32dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Chuông thuần (tắt TTS khi báo thức)" android:textSize="16sp"/>
            <com.example.alarmclock.LoadSwitchView
                android:id="@+id/switchPure"
                android:layout_width="52dp" android:layout_height="32dp"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Chống troll tắt báo thức" android:textStyle="bold"
            android:layout_marginBottom="4dp" android:layout_marginTop="8dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Khi bật: ép âm lượng tối đa, khóa nút Back, ẩn Snooze, bắt buộc PIN để tắt. Nên kèm thử thách Toán / Lắc / Quét mặt."
            android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Bật chống troll" android:textSize="16sp"/>
            <com.example.alarmclock.LoadSwitchView
                android:id="@+id/switchAntiTroll"
                android:layout_width="52dp" android:layout_height="32dp"/>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Mã PIN tắt báo thức (≥4 số)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAntiTrollPin" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberPassword"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAntiTrollPin" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Lưu PIN chống troll"
            android:layout_marginTop="8dp" android:layout_marginBottom="20dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Bảo vệ bộ sưu tập ảnh" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Mật khẩu bộ sưu tập (≥4 ký tự)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGalleryPw" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textPassword"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetGalleryPw" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Đặt / Đổi mật khẩu"
            android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearGalleryPw" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Xóa mật khẩu bộ sưu tập"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Email Google khôi phục">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRecoveryEmail" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textEmailAddress"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveRecovery" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Lưu email khôi phục"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>
