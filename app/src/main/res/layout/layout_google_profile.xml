<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/googleProfileRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/imgGoogleAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_menu_google"
        android:scaleType="centerCrop" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">
        <TextView android:id="@+id/tvGoogleName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
            android:text="Chưa đăng nhập Google" />
        <TextView android:id="@+id/tvGoogleEmail" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
