<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.alarmclock.FaceBoxOverlay
        android:id="@+id/faceBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#E6000000">

        <TextView
            android:id="@+id/tvExprTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Biểu cảm"
            android:textColor="#FCA5A5"
            android:textSize="14sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvFaceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đưa mặt vào khung — đang quét…"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvExprProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 / 3"
            android:textColor="#C7D2FE"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#E6000000">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmFace"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Xác nhận tắt báo thức"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelFace"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Hủy / Quay lại"
            android:textSize="16sp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="@android:color/white"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="1.5dp"
            app:cornerRadius="28dp" />
    </LinearLayout>
</FrameLayout>
