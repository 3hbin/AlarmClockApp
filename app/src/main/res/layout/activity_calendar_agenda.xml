<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#FFFFFFFF"
            app:title="Lịch"
            app:titleTextColor="#FF202124"
            app:navigationIcon="?attr/homeAsUpIndicator" />

        <TextView
            android:id="@+id/tvMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="tháng 9 năm 2026"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FF202124"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="4dp" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabModes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFFFF"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabIndicatorColor="#FF1A73E8"
            app:tabSelectedTextColor="#FF1A73E8"
            app:tabTextColor="#FF5F6368" />

        <FrameLayout
            android:id="@+id/calendarContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddEvent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="Thêm sự kiện"
        app:srcCompat="@android:drawable/ic_input_add"
        app:backgroundTint="#FF1A73E8"
        app:tint="#FFFFFFFF" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
